# -----------------------------------------------------------------------------
# CS2 Inventory Intelligence - configuration
#
# 1. Copy this file to ".env" in the same folder (the real .env is git-ignored,
#    so your keys never get committed).
# 2. Fill in only what you need. Every setting is optional.
# 3. Restart the app after editing.
# -----------------------------------------------------------------------------

# --- API key ------------------------------------------------------------------

# CSFloat API key - enables CSFloat as a price source. This is the only key the app uses.
# Get one (free): log in at https://csfloat.com -> Profile -> "Developers" tab -> create key.
# Keep it private: it belongs to your CSFloat account.
CSFLOAT_API_KEY=

# No other keys are needed: Steam inventory, Steam Market, Skinport, Market.CSGO, Waxpeer,
# profile links and exchange rates all use public, read-only endpoints.
# The app never needs a Steam Web API key - never create one for this tool.

# --- Defaults (all of these can also be changed in the app's Settings dialog) ---

# Your SteamID64 (17 digits, starts with 7656119). Leave blank to enter it in the app.
STEAM_ID64=

# Currency every price is converted to (any ISO code the ECB publishes, e.g. USD, EUR, GBP, CNY).
BASE_CURRENCY=USD

# Price sources to use (comma separated): steam, skinport, csfloat, marketcsgo, waxpeer
ENABLED_MARKETS=steam,skinport,csfloat,marketcsgo,waxpeer

# How one portfolio value is chosen from several markets:
# median | lowest | highest | mean | steam | skinport | csfloat | marketcsgo | waxpeer
VALUATION_STRATEGY=median

# Applied stickers add this share of their cheapest loose price (cheap -> expensive stickers)...
STICKER_RATE_MIN=0.05
STICKER_RATE_MAX=0.15
# ...but the total sticker premium is capped relative to the skin's own price
# (1.0 = stickers can at most double a skin's value; 3x that for 4-of-a-kind crafts).
STICKER_PREMIUM_CAP=1.0

# --- Advanced -----------------------------------------------------------------

# Interface/port for the local web server. Keep 127.0.0.1 so only this PC can open it.
HOST=127.0.0.1
PORT=5000

# Hours before a Steam Market / CSFloat price is fetched again (protects against rate limits).
PRICE_TTL_HOURS=12
# Seconds between Steam Market requests (Steam allows roughly 20 per minute).
STEAM_MARKET_MIN_INTERVAL=3.5
# Currency requested from Skinport (it is normalised to BASE_CURRENCY anyway).
SKINPORT_CURRENCY=EUR

# Take a portfolio snapshot automatically once per day while the app is running.
AUTO_DAILY_SNAPSHOT=true
# Re-sync the saved Steam inventory as part of the daily update.
AUTO_SYNC_STEAM=true
# The automatic background update (scripts\install-daily-update.ps1) never runs before this time of
# day (24-hour clock): it runs at this time if the PC is on, or as soon as it's on after that, and
# retries hourly if the markets can't be reached. Opening the dashboard updates straight away anyway.
DAILY_UPDATE_TIME=12:00
# Find pictures for items you add by hand (from a public item catalogue on GitHub).
ITEM_IMAGES=true
